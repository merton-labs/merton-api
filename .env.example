# Copy to .env for local development: cp .env.example .env
# Never commit .env.

# HTTP listener
APP_HOST=127.0.0.1
APP_PORT=8080

# Database (relative SQLite paths resolve from the working directory)
DATABASE_URL=sqlite://data/merton.db
DATABASE_MAX_CONNECTIONS=5
DATABASE_BUSY_TIMEOUT_MS=5000

# Required server secret (at least 32 bytes) used to derive CSRF tokens.
# Keep it stable across restarts. Generate one with: openssl rand -base64 48
APP_SECRET_KEY=

# Origins allowed to send state-changing browser requests (comma-separated,
# exact scheme://host[:port]). Set to your public URL behind a reverse proxy.
APP_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Secure (and __Host- prefixed) session cookies. false is accepted only when
# every trusted origin is http://localhost, http://127.0.0.1 or http://[::1].
SESSION_COOKIE_SECURE=false

# Reverse proxy IPs whose X-Forwarded-For is trusted (comma-separated).
TRUSTED_PROXIES=

# Maximum concurrent Argon2 password operations (1-64, ~19 MiB each).
# Further sign-in/registration requests get 503 until capacity frees up.
AUTH_MAX_CONCURRENT_HASHES=4

# Log filter (tracing EnvFilter syntax)
RUST_LOG=merton_api=info,tower_http=info,sqlx=warn
